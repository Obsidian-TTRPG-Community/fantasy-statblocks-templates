                    "conditioned": true,
                    "callback": "const C={'0':[0,10],'1/8':[0.125,25],'1/4':[0.25,50],'1/2':[0.5,100],'0.125':[0.125,25],'0.25':[0.25,50],'0.5':[0.5,100],'1':[1,200],'2':[2,450],'3':[3,700],'4':[4,1100],'5':[5,1800],'6':[6,2300],'7':[7,2900],'8':[8,3900],'9':[9,5000],'10':[10,5900],'11':[11,7200],'12':[12,8400],'13':[13,10000],'14':[14,11500],'15':[15,13000],'16':[16,15000],'17':[17,18000],'18':[18,20000],'19':[19,22000],'20':[20,25000],'21':[21,33000],'22':[22,41000],'23':[23,50000],'24':[24,62000],'25':[25,75000],'26':[26,90000],'27':[27,105000],'28':[28,120000],'29':[29,135000],'30':[30,155000]};const cr=monster.cr!=null?String(monster.cr):'';if(!(cr in C)){return monster.cr!=null?String(monster.cr):'';}const v=C[cr][0],xp=C[cr][1];const pb=Math.max(Math.floor(2+(v-1)/4),2);let o=cr+' (XP '+xp.toLocaleString();if(monster.lair_xp!=null&&monster.lair_xp!==''){const lx=Number(monster.lair_xp);o+=', or '+(isNaN(lx)?monster.lair_xp:lx.toLocaleString())+' in lair';}o+='; PB +'+pb+')';return o;"
