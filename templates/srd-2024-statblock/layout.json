                            "conditioned": true,
                            "callback": "const sz=monster.size||'';const tp=monster.type||'';const sb=monster.subtype||'';const al=monster.alignment||'';let o=[sz,tp].filter(Boolean).join(' ');if(sb){o+=' ('+sb+')';}if(al){o+=(o?', ':'')+al;}return o;"
