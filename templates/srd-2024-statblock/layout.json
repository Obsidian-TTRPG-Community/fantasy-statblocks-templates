                    "nested": [
                        {
                            "type": "property",
                            "id": "ac",
                            "properties": [
                                "ac"
                            ],
                            "display": "AC",
                            "conditioned": true,
                            "callback": "if(monster.ac!=null&&(''+monster.ac).length){return ''+monster.ac;}if(monster.ac_class){return ''+monster.ac_class;}return '';"
                        },
                        {
                            "type": "property",
                            "id": "initiative",
                            "properties": [
                                "initiative_modifier",
                                "initiativeModifier",
                                "modifier",
                                "initiative",
                                "stats"
                            ],
                            "display": "Initiative",
                            "conditioned": true,
                            "callback": "const s=monster.stats||[];const d=Number(s[1]);const raw=monster.initiative_modifier??monster.initiativeModifier??monster.modifier??monster.initiative;let m;if(Array.isArray(raw)){const values=raw.map(Number).filter(Number.isFinite);if(values.length){m=values.reduce((sum,value)=>sum+value,0);}}else if(raw!=null&&raw!==''){const value=Number(raw);if(Number.isFinite(value)){m=value;}}if(m==null&&Number.isFinite(d)){m=Math.floor((d-10)/2);}if(m==null){return '';}const sc=10+m;return (m>=0?'+':'')+m+' ('+sc+')';"
                        }
                    ]
                },
                {
                    "type": "property",
                    "id": "hp",
                    "properties": [
                        "hp"
                    ],
                    "display": "HP",
                    "conditioned": true,
                    "dice": true,
                    "diceProperty": "hit_dice",
                    "diceCallback": "const d=monster.hit_dice;return d&&String(d).trim()?[{text:String(d).trim()}]:property;",
                    "callback": "const hp=monster.hp==null?'':String(monster.hp).trim();const dice=monster.hit_dice==null?'':String(monster.hit_dice).trim();return hp+(dice?' ('+dice+')':'');"
                },
                {
                    "type": "property",
                    "id": "speed",
                    "properties": [
                        "speed"
                    ],
                    "display": "Speed",
                    "conditioned": true
                }
            ]
        },
        {
            "type": "javascript",
            "id": "ability-grid",
            "properties": [],
            "code": "var N=['Strength','Dexterity','Constitution','Intelligence','Wisdom','Charisma'];var A=['STR','DEX','CON','INT','WIS','CHA'];var st=monster.stats||[];var sv=monster.saves||{};var SM={};if(Array.isArray(sv)){for(var q=0;q<sv.length;q++){var o=sv[q];if(o&&o.name!=null&&o.desc!=null){SM[(''+o.name).toLowerCase()]=o.desc;}else if(o){for(var k2 in o){SM[k2.toLowerCase()]=o[k2];}}}}else if(sv&&typeof sv==='object'){for(var k3 in sv){SM[k3.toLowerCase()]=sv[k3];}}function mod(x){return Math.floor((Number(x)-10)/2);}function f(n){return (n>=0?'+':'')+n;}var table=document.createElement('table');table.className='sb24-abilities';var cg=document.createElement('colgroup');var W=['15%','7.5%','7.5%'];for(var g=0;g<3;g++){if(g>0){var gp=document.createElement('col');gp.style.width='5%';cg.appendChild(gp);}for(var k=0;k<3;k++){var c=document.createElement('col');c.style.width=W[k];cg.appendChild(c);}}table.appendChild(cg);var thead=document.createElement('thead');var hr=document.createElement('tr');for(var g=0;g<3;g++){if(g>0){var hg=document.createElement('th');hg.className='sb24-gap';hr.appendChild(hg);}var b1=document.createElement('th');b1.className='sb24-blank';hr.appendChild(b1);var hm=document.createElement('th');hm.className='sb24-h';hm.textContent='MOD';hr.appendChild(hm);var hs=document.createElement('th');hs.className='sb24-h';hs.textContent='SAVE';hr.appendChild(hs);}thead.appendChild(hr);table.appendChild(thead);var tbody=document.createElement('tbody');var rows=[[0,1,2],[3,4,5]];for(var ri=0;ri<rows.length;ri++){var tr=document.createElement('tr');for(var ci=0;ci<3;ci++){var i=rows[ri][ci];var score=Number(st[i]);var has=!isNaN(score);var m=mod(score);var raw=SM[N[i].toLowerCase()];var saveStr;if(raw!=null&&raw!==''){var nr=Number(raw);saveStr=isNaN(nr)?(''+raw):f(nr);}else{saveStr=f(m);}if(ci>0){var gd=document.createElement('td');gd.className='sb24-gap';tr.appendChild(gd);}var ns=document.createElement('td');ns.className='sb24-namescore';if(ci>0){ns.classList.add('sb24-div');}var an=document.createElement('span');an.className='sb24-name';an.textContent=A[i];var sn=document.createElement('span');sn.className='sb24-score';sn.textContent=has?String(score):'—';ns.appendChild(an);ns.appendChild(document.createTextNode(' '));ns.appendChild(sn);var md=document.createElement('td');md.className='sb24-mod';md.textContent=has?f(m):'';var sd=document.createElement('td');sd.className='sb24-save';sd.textContent=has?saveStr:'';tr.appendChild(ns);tr.appendChild(md);tr.appendChild(sd);}tbody.appendChild(tr);}table.appendChild(tbody);return table;"
        },
